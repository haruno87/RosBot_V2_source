# ===========================================
# RosBot V2 - API 密钥配置文件模板
# 复制此文件为 .env 并填入真实密钥
# cp .env.example .env
# ===========================================

# 百度文心大模型 (ERNIE)
# 获取地址: https://qianfan.cloud.baidu.com/
BAIDU_ERNIE_API_KEY=your_api_key_here
BAIDU_ERNIE_APP_ID=app-mRnuUVg8
BAIDU_ERNIE_MODEL=ernie-lite-pro-128k
BAIDU_ERNIE_VLM_MODEL=ernie-4.5-vl-28b-a3b

# 百度语音 API (ASR/TTS)
# 获取地址: https://ai.baidu.com/tech/speech
BAIDU_SPEECH_API_KEY=your_api_key_here
BAIDU_SPEECH_SECRET_KEY=your_secret_key_here

# 阿里云 DashScope (Qwen + ASR/TTS)
# 获取地址: https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# 阿里云呼叫中心 (CCC)
# 获取地址: https://ccc.console.aliyun.com/
ALIBABA_CLOUD_ACCESS_KEY_ID=your_access_key_id_here
ALIBABA_CLOUD_ACCESS_KEY_SECRET=your_access_key_secret_here
ALIBABA_CCC_INSTANCE_ID=demo-1645515438393388
ALIBABA_CCC_CALLER_ID=your_caller_number_here

# 高德地图 API (天气查询)
# 获取地址: https://lbs.amap.com/dev/
AMAP_API_KEY=your_amap_api_key_here

# SMS宝 (短信发送)
# 获取地址: http://www.smsbao.com/
SMSBAO_USER=your_username_here
SMSBAO_PASSWORD=your_password_here

# 紧急联系人
EMERGENCY_PHONE=your_emergency_phone_here
EMERGENCY_SMS_CONTENT=老人疑似发生摔倒事件！请及时处理！
